# IBKR Connection (IB Gateway)
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1

# Trading parameters
MAX_RISK_PERCENT=1.0
MAX_POSITION_SIZE=10.0
MIN_POSITION_SIZE=1.0
DEFAULT_SL_DISTANCE=50.0
DEFAULT_TP_DISTANCE=100.0

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# App
API_SECRET_KEY=your_api_secret_key
DATABASE_URL=sqlite+aiosqlite:///./trades.db
LOG_LEVEL=INFO

# -------- Trading Mode --------
# classic = fixed-strategy cron scanners (scan_scalp, scan_swing, etc.)
# ai      = AI orchestrator on host drives decisions via TradingView MCP + Claude CLI
TRADING_MODE=classic

# -------- AI Mode Config (only used when TRADING_MODE=ai) --------
# If true, AI logs decisions but does not submit trades (safety net for first runs)
AI_PAPER_MODE=false

# During live testing with AI mode, set these low for minimum position sizes
# conviction_high_risk_pct=0.5
# conviction_medium_risk_pct=0.25
