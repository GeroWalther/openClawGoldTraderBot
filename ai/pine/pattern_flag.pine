//@version=5
indicator("Krabbe: Flag/Pennant Detector", overlay=true)

// AI uses this to verify bull/bear flag patterns.
// A valid flag = strong directional move (pole) + counter-trend consolidation (flag).

pole_lookback = input.int(20, "Pole Lookback")
pole_min_pct = input.float(2.0, "Pole Min Move %", minval=0.5)
flag_bars = input.int(10, "Flag Consolidation Bars", minval=3)
flag_max_retrace = input.float(0.5, "Flag Max Retrace (0-1)", minval=0.2, maxval=0.7)

// Calculate pole start (N bars ago before the flag)
pole_start_bar = pole_lookback + flag_bars
pole_high = ta.highest(high, pole_lookback)[flag_bars]
pole_low = ta.lowest(low, pole_lookback)[flag_bars]

// Pole: strongest move in pole_lookback bars ending at pole_end (flag_bars ago)
move_up = (pole_high - pole_low) / pole_low * 100
pole_direction = ta.highest(close, pole_lookback)[flag_bars] >= close[flag_bars] ? "up" : "down"
pole_is_bull = close[flag_bars] > close[pole_start_bar]
pole_pct = math.abs(close[flag_bars] - close[pole_start_bar]) / close[pole_start_bar] * 100

valid_pole = pole_pct >= pole_min_pct

// Flag: last flag_bars should be consolidating within flag_max_retrace of pole
flag_high = ta.highest(high, flag_bars)
flag_low = ta.lowest(low, flag_bars)
flag_range = flag_high - flag_low
pole_range = math.abs(close[flag_bars] - close[pole_start_bar])

valid_flag_range = flag_range <= pole_range * flag_max_retrace

// Bull flag: bull pole + retrace down
bull_flag = pole_is_bull and valid_pole and valid_flag_range and flag_low > (close[flag_bars] - pole_range * flag_max_retrace)

// Bear flag: bear pole + retrace up
bear_flag = not pole_is_bull and valid_pole and valid_flag_range and flag_high < (close[flag_bars] + pole_range * flag_max_retrace)

// Draw
if barstate.islast and (bull_flag or bear_flag)
    label.new(bar_index, bull_flag ? high + (flag_range * 0.5) : low - (flag_range * 0.5),
              text=bull_flag ? "BULL FLAG" : "BEAR FLAG",
              color=bull_flag ? color.green : color.red,
              textcolor=color.white,
              style=bull_flag ? label.style_label_down : label.style_label_up)

// Info table
var table flagTable = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 80))
if barstate.islast
    table.cell(flagTable, 0, 0, "Pattern", text_color=color.white)
    table.cell(flagTable, 1, 0, bull_flag ? "BULL FLAG" : (bear_flag ? "BEAR FLAG" : "NONE"), text_color=bull_flag ? color.lime : (bear_flag ? color.red : color.gray))
    table.cell(flagTable, 0, 1, "Pole %", text_color=color.white)
    table.cell(flagTable, 1, 1, str.tostring(pole_pct, "#.##") + "%", text_color=color.yellow)
    table.cell(flagTable, 0, 2, "Pole Valid", text_color=color.white)
    table.cell(flagTable, 1, 2, valid_pole ? "YES" : "no", text_color=valid_pole ? color.lime : color.gray)
    table.cell(flagTable, 0, 3, "Flag OK", text_color=color.white)
    table.cell(flagTable, 1, 3, valid_flag_range ? "YES" : "no", text_color=valid_flag_range ? color.lime : color.gray)
    table.cell(flagTable, 0, 4, "Breakout @", text_color=color.white)
    table.cell(flagTable, 1, 4, bull_flag ? str.tostring(flag_high + syminfo.mintick, format.mintick) : (bear_flag ? str.tostring(flag_low - syminfo.mintick, format.mintick) : "--"), text_color=color.yellow)
