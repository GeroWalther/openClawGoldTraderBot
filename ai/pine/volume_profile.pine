//@version=5
indicator("Krabbe: Volume/Momentum Context", overlay=false)

// AI uses this to quantify momentum + volume context for any setup.
// Outputs: ATR context, volume context, momentum (ROC), and a composite "conviction score".

atr_len = input.int(14, "ATR Length")
vol_len = input.int(20, "Volume Average Length")
roc_len = input.int(10, "ROC Length")

atr = ta.atr(atr_len)
atr_avg = ta.sma(atr, 20)
atr_ratio = atr / atr_avg

vol_avg = ta.sma(volume, vol_len)
vol_ratio = volume / vol_avg

roc = ta.roc(close, roc_len)

// Conviction score: combine ATR expansion + volume + momentum
// - ATR expanding + volume > avg + |ROC| > 1% = strong directional move
atr_score = atr_ratio >= 1.2 ? 2 : (atr_ratio >= 0.9 ? 1 : 0)
vol_score = vol_ratio >= 1.5 ? 2 : (vol_ratio >= 1.0 ? 1 : 0)
roc_score = math.abs(roc) >= 2 ? 2 : (math.abs(roc) >= 1 ? 1 : 0)

conviction = atr_score + vol_score + roc_score  // 0-6

context = conviction >= 5 ? "STRONG" : conviction >= 3 ? "MODERATE" : "WEAK"
direction_bias = roc > 0.5 ? "BULL" : roc < -0.5 ? "BEAR" : "NEUTRAL"

// Plot momentum
plot(roc, "ROC", color=roc > 0 ? color.green : color.red, linewidth=2)
hline(0, "Zero", color.gray)
hline(2, "Strong+", color.new(color.green, 60), linestyle=hline.style_dashed)
hline(-2, "Strong-", color.new(color.red, 60), linestyle=hline.style_dashed)

bgcolor(conviction >= 5 ? color.new(color.yellow, 90) : na)

// Table output for AI
var table infoTable = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80))
if barstate.islast
    table.cell(infoTable, 0, 0, "Context", text_color=color.white)
    table.cell(infoTable, 1, 0, context, text_color=conviction >= 5 ? color.lime : (conviction >= 3 ? color.yellow : color.gray))
    table.cell(infoTable, 0, 1, "Bias", text_color=color.white)
    table.cell(infoTable, 1, 1, direction_bias, text_color=direction_bias == "BULL" ? color.lime : (direction_bias == "BEAR" ? color.red : color.gray))
    table.cell(infoTable, 0, 2, "ATR Ratio", text_color=color.white)
    table.cell(infoTable, 1, 2, str.tostring(atr_ratio, "#.##") + "x", text_color=color.yellow)
    table.cell(infoTable, 0, 3, "Vol Ratio", text_color=color.white)
    table.cell(infoTable, 1, 3, str.tostring(vol_ratio, "#.##") + "x", text_color=color.yellow)
    table.cell(infoTable, 0, 4, "ROC %", text_color=color.white)
    table.cell(infoTable, 1, 4, str.tostring(roc, "#.##") + "%", text_color=roc > 0 ? color.lime : color.red)
    table.cell(infoTable, 0, 5, "Conviction", text_color=color.white)
    table.cell(infoTable, 1, 5, str.tostring(conviction) + "/6", text_color=conviction >= 5 ? color.lime : color.gray)
